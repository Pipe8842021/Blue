# Artefactos de pruebas con Playwright
.playwright-mcp/

# Imágenes subidas por usuarios (la carpeta se conserva con .gitkeep)
assets/img/gallery/*
!assets/img/gallery/.gitkeep
!assets/img/gallery/.htaccess
assets/img/servicios/*
!assets/img/servicios/.gitkeep
!assets/img/servicios/.htaccess

# Archivos del sistema / editor
.claude/
Thumbs.db
.DS_Store
*.log
.vscode/
.idea/

# Archivos temporales/copias de Word
~$*.docx
*_ACTUALIZADO.docx

# Llaves reales de la pasarela de pagos (Wompi) — nunca se versionan
config/wompi.local.php

# Credenciales reales de correo (SMTP) — nunca se versionan
config/mail.local.php

# Correos de prueba guardados en modo demo (metodo=log)
logs/correos/
